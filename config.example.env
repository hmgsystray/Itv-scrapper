# Configuración del scraper de ITV Argentona

# Matrícula del vehículo (sin espacios ni guiones) - REQUERIDO
# IMPORTANTE: El servidor valida las matrículas. Usa tu matrícula real o una conocida
# Ejemplo: 6784BDR (matrícula de prueba que funciona)
LICENSE_PLATE=6784BDR

# Discord Webhook URL - OPCIONAL
# Si no se configura, las notificaciones se mostrarán solo por terminal
# Crear webhook: Ajustes del canal → Integraciones → Webhooks → Nuevo Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# Opciones del monitor
# Intervalo de revisión en minutos (recomendado: 5-10 minutos)
MONITOR_INTERVAL_MINUTES=5

# Días de anticipación para notificar (solo notifica citas en próximos N días)
DAYS_LIMIT=15
