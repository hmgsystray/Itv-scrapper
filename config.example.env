# Configuración del scraper de ITV Argentona

# Matrícula del vehículo (sin espacios ni guiones)
LICENSE_PLATE=1234ABC

# Discord Webhook URL (REQUERIDO para monitoreo)
# Crear webhook: Ajustes del canal → Integraciones → Webhooks → Nuevo Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# Opciones del monitor
# Intervalo de revisión en minutos (recomendado: 5-10 minutos)
MONITOR_INTERVAL_MINUTES=5
