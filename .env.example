# Configuracion del ITV Monitor

# ESTACIONES A MONITORIZAR
# Formato: CODIGO:MATRICULA:NOMBRE,CODIGO:MATRICULA:NOMBRE
# - CODIGO: Codigo de la estacion ITV (obligatorio, ej: B08)
# - MATRICULA: Matricula del vehiculo (opcional, si vacio genera aleatoria)
# - NOMBRE: Nombre personalizado para mostrar en Discord (opcional, por defecto "ITV CODIGO")
#
# Ejemplos:
# Una estacion con matricula y nombre personalizado:
STATIONS=B08:6784BDR:ITV Argentona

# Multiples estaciones:
# STATIONS=B08:6784BDR:ITV Argentona,B07:6146CXR:ITV Mollet del Valles,B01:1234ABC:ITV Barcelona

# Con matricula aleatoria (deja el campo de matricula vacio):
# STATIONS=B08::ITV Argentona

# Sin nombre personalizado (usara "ITV B08"):
# STATIONS=B08:6784BDR

# DISCORD WEBHOOK (opcional)
# Si no se configura, las notificaciones se mostraran solo por terminal
# Crear webhook: Ajustes del canal -> Integraciones -> Webhooks -> Nuevo Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# INTERVALO DE REVISION (minutos)
# Tiempo entre cada revision de citas (recomendado: 5-10 minutos)
MONITOR_INTERVAL_MINUTES=5

# LIMITE DE DIAS
# Solo notificar citas dentro de los proximos N dias
DAYS_LIMIT=45
